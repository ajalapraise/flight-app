# Public values — safe to ship to the browser. Find them in
# Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional. Only used by the seed script (scripts/seed-test-user.ts) to
# create the test user via the admin API. Never expose this in any client
# component. Leave blank if you'll create the test user manually in the
# Supabase Auth dashboard.
SUPABASE_SERVICE_ROLE_KEY=
